{
  "name": "@secure-integration/admin-web",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "packageManager": "npm@10.9.8",
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage.enabled=false",
    "test:a11y": "vitest run src/accessibility.test.tsx",
    "test:ui-mock": "playwright test",
    "test:e2e": "playwright test --config playwright.fullstack.config.ts",
    "generate:api": "openapi-typescript ../../../docs/api/gateway-openapi.yaml -o src/api/schema.d.ts",
    "check:api": "npm run generate:api && git diff --exit-code -- src/api/schema.d.ts",
    "generate:runtime": "node scripts/generate-runtime-contract.mjs",
    "check:runtime": "npm run generate:runtime && npm run test:runtime-negative && git diff --exit-code -- ../../../docs/api/runtime-wire-codes.json src/i18n/runtimeContract.generated.ts",
    "test:runtime-negative": "node scripts/check-runtime-negative.mjs",
    "capture:screenshot": "node tests/capture-sanitized-screenshot.mjs"
  },
  "dependencies": {
    "@codemirror/view": "6.43.8",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.3.0",
    "@tanstack/react-query": "5.101.4",
    "@uiw/react-codemirror": "4.25.11",
    "ajv": "8.20.0",
    "i18next": "26.3.6",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "react-i18next": "17.0.11",
    "react-router-dom": "5.3.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-router-dom": "5.3.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "jsdom": "28.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
